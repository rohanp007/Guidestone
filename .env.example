# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# Random string, 32+ characters, used to sign session cookies. Generate: .venv/bin/python3 scripts/hash_password.py --secret
SESSION_SECRET=

# argon2 hash of the shared demo password (never the password itself). Generate: .venv/bin/python3 scripts/hash_password.py 'the password'
# Keep the single quotes: the hash contains $ characters.
DEMO_PASSWORD_HASH=''

# true: the login page shows "Sign in as ..." buttons for the featured customers, the customer list and /debug are available.
# false (production): customers sign in with email and password only.
DEMO_MODE=false

# true when the API is served over HTTPS (sets the Secure flag on the session cookie)
COOKIE_SECURE=false

# Session lifetime in hours (default 8)
SESSION_HOURS=8

# Deployed frontend origin allowed by CORS, in addition to http://localhost:3000
FRONTEND_ORIGIN=
