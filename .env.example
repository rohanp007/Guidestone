# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# Random string, 32+ characters, used to sign session cookies. Generate: .venv/bin/python3 scripts/hash_password.py --secret
SESSION_SECRET=

# argon2 hash of the shared demo password (never the password itself). Generate: .venv/bin/python3 scripts/hash_password.py 'the password'
# Keep the single quotes: the hash contains $ characters.
DEMO_PASSWORD_HASH=''

# true: the login page shows "Sign in as ..." buttons for the featured customers, the customer list and /debug are available.
# false (production): customers sign in with email and password only.
DEMO_MODE=false

# true when the API is served over HTTPS (sets the Secure flag on the session cookie)
COOKIE_SECURE=false

# Session lifetime in hours (default 8)
SESSION_HOURS=8

# Deployed frontend origin allowed by CORS, in addition to http://localhost:3000
FRONTEND_ORIGIN=

# --- LLM (OpenAI-compatible local servers) ---
# Defaults: every agent, the advisor included -> llama-server http://localhost:1235/v1 (nemotron-nano-4b-nothink, reasoning disabled).
#           Option: the advisor with reasoning on (slower, ~15 s): LLM_ADVISOR_BACKEND=lmstudio, LLM_ADVISOR_BASE_URL=http://localhost:1234/v1,
#           LLM_ADVISOR_MODEL=nvidia/nemotron-3-nano-4b, LLM_ADVISOR_REASONING=true, LLM_ADVISOR_TIMEOUT=60, ADVISOR_BUDGET_S=30
# LLM_BASE_URL=http://localhost:1234/v1          # fallback for an agent with no base URL of its own, once moved off its default backend
# LLM_API_KEY=lm-studio
# Per agent (ORCHESTRATOR, RESEARCHER, PRESENTER, ADVISOR): LLM_<AGENT>_{BACKEND (lmstudio|llamacpp|hosted),BASE_URL,MODEL,REASONING,TIMEOUT,TEMPERATURE,MAX_TOKENS}
# LLM_ORCHESTRATOR_MAX_TOKENS=512

# --- frontend (frontend/.env.local, gitignored) ---
# API_ORIGIN=http://localhost:8000      # where the Next server forwards /api/* (the browser only talks to Next, so the cookie is same-origin)
# DEMO_MODE=true                        # same meaning as above; /debug is a 404 unless true
# DEMO_PASSWORD_HINT=                   # shown on the login page in demo mode (the demo password, never the hash)
